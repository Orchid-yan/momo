# 阿里云百炼（DashScope）API Key
# 获取：https://bailian.console.aliyun.com/ 或 https://modelstudio.console.aliyun.com/
# 切勿把真实密钥提交到 Git。开发时复制本文件为 .env，或在应用「设置」里填写。
DASHSCOPE_API_KEY=

# OpenAI 兼容接口 Base URL（不要带 /chat/completions）
# 北京：https://dashscope.aliyuncs.com/compatible-mode/v1
# 新加坡：https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 美东弗吉尼亚：https://dashscope-us.aliyuncs.com/compatible-mode/v1
# API Key 与地域必须一致，否则会 401。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称，例如 qwen-plus / qwen-turbo / qwen-max
DASHSCOPE_MODEL=qwen-plus
